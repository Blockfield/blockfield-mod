+package com.lunares.blockfield.server.combat;
+
+import com.lunares.blockfield.common.combat.AnimationGraphState;
+import com.lunares.blockfield.common.combat.AnimationStartReport.StartKey;
+import com.lunares.blockfield.common.combat.AnimationState;
+import com.lunares.blockfield.common.combat.ObserverReducer;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * UPERF PROTOTYPE ONLY: how many server-side reducer steps (folds and receipt rows) repeat a step
+ * another observer already took for the same target life and bucket from the same presentation.
+ * The key is the pre-step composed graph and ParCool value with the reduction's own seed id
+ * relabelled (the only observer-minted label in a reduced graph); each repeat also compares the
+ * relabelled post-step graph with the first one, which tests that relabelling is result-neutral.
+ */
+final class UperfShare {
+    private UperfShare() {}
+
+    static boolean server;
+    static final boolean ON = Boolean.getBoolean("blockfield.uperf.share");
+
+    record Key(
+            long target, long bucket, AnimationGraphState graph, AnimationState.ParCool parcool) {}
+
+    private static final Map<Key, AnimationGraphState> SEEN = new HashMap<>();
+    // Distinct pre-states per (target, bucket) as key hashes: counting only, bounded memory.
+    private static final Map<Long, Map<Long, Set<Integer>>> CLASSES = new HashMap<>();
+    private static final Map<String, Key> FIRST = new HashMap<>();
+    private static final Map<Long, Map<Long, Integer>> STEPS = new HashMap<>();
+    private static long steps, hits, mismatches, stepNanos, hitNanos, probeNanos, lastPrune;
+    private static Key pending;
+    private static long started;
+
+    static {
+        if (ON) ObserverReducer.STEP_PROBE = new Probe();
+    }
+
+    static void reset() {
+        SEEN.clear();
+        FIRST.clear();
+        CLASSES.clear();
+        STEPS.clear();
+        steps = hits = mismatches = stepNanos = hitNanos = probeNanos = 0;
+    }
+
+    private static final class Probe implements ObserverReducer.StepProbe {
+        @Override
+        public void before(ObserverReducer.Reduction reduction, AnimationState checkpoint) {
+            pending = null;
+            if (!server || !UperfProbe.on) return;
+            long t0 = System.nanoTime();
+            long seedId = reduction.seed().ref().contentId();
+            var result = reduction.result();
+            long target = reduction.seed().identity().targetEpoch();
+            long bucket = checkpoint.serverTick();
+            pending =
+                    new Key(
+                            target,
+                            bucket,
+                            normalize(result.pa().graph(), seedId),
+                            normalize(result.parcool(), seedId));
+            if (bucket - lastPrune > 20) {
+                SEEN.keySet().removeIf(k -> k.bucket() < bucket - 60);
+                FIRST.values().removeIf(k -> k.bucket() < bucket - 60);
+                lastPrune = bucket;
+            }
+            started = System.nanoTime();
+            probeNanos += started - t0;
+        }
+
+        @Override
+        public void after(ObserverReducer.Reduction reduction) {
+            long dt = System.nanoTime() - started;
+            var key = pending;
+            pending = null;
+            if (key == null) return;
+            long t0 = System.nanoTime();
+            steps++;
+            stepNanos += dt;
+            var set =
+                    CLASSES.computeIfAbsent(key.target(), k -> new HashMap<>())
+                            .computeIfAbsent(key.bucket(), k -> new HashSet<>());
+            if (DIAG > 0) {
+                var first = FIRST.putIfAbsent(key.target() + ":" + key.bucket(), key);
+                if (first != null && !first.equals(key)) {
+                    DIAG--;
+                    diff(first, key);
+                }
+            }
+            set.add(key.hashCode());
+            STEPS.computeIfAbsent(key.target(), k -> new HashMap<>())
+                    .merge(key.bucket(), 1, Integer::sum);
+            var post = normalize(reduction.result().pa().graph(), reduction.seed().ref().contentId());
+            var first = SEEN.get(key);
+            if (first == null) SEEN.put(key, post);
+            else {
+                hits++;
+                hitNanos += dt;
+                if (!first.equals(post)) mismatches++;
+            }
+            probeNanos += System.nanoTime() - t0;
+        }
+    }
+
+    private static int DIAG = Integer.getInteger("blockfield.uperf.shareDiag", 0);
+
+    /** Prints where two presentations of one target and bucket differ. */
+    private static void diff(Key a, Key b) {
+        var na = a.graph().nodes();
+        var nb = b.graph().nodes();
+        var sb = new StringBuilder("UPERF-DIFF target=" + a.target() + " bucket=" + a.bucket());
+        sb.append(" nodes=").append(na.size()).append('/').append(nb.size());
+        sb.append(" roots=").append(a.graph().roots().equals(b.graph().roots()));
+        sb.append(" aliases=").append(a.graph().aliases().equals(b.graph().aliases()));
+        sb.append(" parcool=").append(java.util.Objects.equals(a.parcool(), b.parcool()));
+        var ida = new java.util.TreeMap<Integer, AnimationGraphState.Node>();
+        for (var n : na) ida.put(n.id(), n);
+        var idb = new java.util.TreeMap<Integer, AnimationGraphState.Node>();
+        for (var n : nb) idb.put(n.id(), n);
+        sb.append(" ids=").append(ida.keySet().equals(idb.keySet()) ? "same" : ida.keySet() + " vs " + idb.keySet());
+        int shown = 0;
+        for (var e : ida.entrySet()) {
+            var other = idb.get(e.getKey());
+            if (other == null || other.equals(e.getValue())) continue;
+            if (shown++ >= 3) break;
+            var x = e.getValue();
+            sb.append("\n  node ").append(x.id()).append(" start ").append(x.start()).append(" vs ").append(other.start());
+            String dx = String.valueOf(x.data()), dy = String.valueOf(other.data());
+            int i = 0;
+            while (i < Math.min(dx.length(), dy.length()) && dx.charAt(i) == dy.charAt(i)) i++;
+            sb.append("\n    a: …").append(dx, Math.max(0, i - 80), Math.min(dx.length(), i + 120));
+            sb.append("\n    b: …").append(dy, Math.max(0, i - 80), Math.min(dy.length(), i + 120));
+        }
+        if (!java.util.Objects.equals(a.parcool(), b.parcool())) {
+            String dx = String.valueOf(a.parcool()), dy = String.valueOf(b.parcool());
+            int i = 0;
+            while (i < Math.min(dx.length(), dy.length()) && dx.charAt(i) == dy.charAt(i)) i++;
+            sb.append("\n  parcool a: …").append(dx, Math.max(0, i - 60), Math.min(dx.length(), i + 100));
+            sb.append("\n  parcool b: …").append(dy, Math.max(0, i - 60), Math.min(dy.length(), i + 100));
+        }
+        System.out.println(sb);
+    }
+
+    private static StartKey relabel(StartKey key, long seedId) {
+        return key != null && key.eventSequence() == seedId ? new StartKey(-1, key.nodeId()) : key;
+    }
+
+    static AnimationGraphState normalize(AnimationGraphState graph, long seedId) {
+        var nodes = new ArrayList<AnimationGraphState.Node>(graph.nodes().size());
+        for (var node : graph.nodes())
+            nodes.add(
+                    new AnimationGraphState.Node(
+                            node.id(), node.domain(), relabel(node.start(), seedId), node.data()));
+        return new AnimationGraphState(graph.roots(), nodes, graph.aliases());
+    }
+
+    static AnimationState.ParCool normalize(AnimationState.ParCool old, long seedId) {
+        if (old == null) return null;
+        return new AnimationState.ParCool(
+                old.animator(),
+                relabel(old.passiveStart(), seedId),
+                old.option(),
+                old.passive(),
+                old.actions(),
+                old.hangGrid(),
+                old.diveGrid());
+    }
+
+    static Map<String, Object> snapshot(int ticks) {
+        var out = new LinkedHashMap<String, Object>();
+        out.put("enabled", ON);
+        if (!ON) return out;
+        long groups = 0, classes = 0;
+        int maxClasses = 0;
+        var histogram = new java.util.TreeMap<Integer, Long>();
+        for (var target : CLASSES.entrySet())
+            for (var bucket : target.getValue().entrySet()) {
+                groups++;
+                int n = bucket.getValue().size();
+                classes += n;
+                maxClasses = Math.max(maxClasses, n);
+                histogram.merge(n, 1L, Long::sum);
+            }
+        out.put("serverStepsPerTick", (double) steps / ticks);
+        out.put("stepUsMean", steps == 0 ? 0 : stepNanos / 1e3 / steps);
+        out.put("repeatedSteps", hits);
+        out.put("repeatedShare", steps == 0 ? 0 : (double) hits / steps);
+        out.put("repeatedStepMsPerTick", hitNanos / 1e6 / ticks);
+        out.put("allStepMsPerTick", stepNanos / 1e6 / ticks);
+        out.put("relabelMismatches", mismatches);
+        out.put("targetBuckets", groups);
+        out.put("classesPerTargetBucketMean", groups == 0 ? 0 : (double) classes / groups);
+        out.put("classesPerTargetBucketMax", maxClasses);
+        out.put("classesHistogram", histogram);
+        out.put("probeMsPerTick", probeNanos / 1e6 / ticks);
+        return out;
+    }
+}
