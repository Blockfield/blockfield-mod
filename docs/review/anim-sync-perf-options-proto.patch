diff --git a/server/src/main/java/com/lunares/blockfield/server/combat/UperfProbe.java b/server/src/main/java/com/lunares/blockfield/server/combat/UperfProbe.java
new file mode 100644
index 00000000..6d909b8a
--- /dev/null
+++ b/server/src/main/java/com/lunares/blockfield/server/combat/UperfProbe.java
@@ -0,0 +1,126 @@
+package com.lunares.blockfield.server.combat;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * UPERF PROTOTYPE ONLY (docs/review/anim-sync-perf-options.md): stage timers for the END-tick
+ * pose, capture and stream, and a mock-dispatch counter fed by the benchmark. Off (the default)
+ * every call is one volatile read; nothing here changes a value.
+ */
+public final class UperfProbe {
+    private UperfProbe() {}
+
+    public static volatile boolean on;
+
+    /** Incremented by the benchmark's Mockito invocation listener. */
+    public static long mockCalls;
+
+    static final String[] NAMES = {
+        // level 0: ServerBodyPoses.evaluateInner
+        "r10.inputs",
+        "r10.parcoolVanillaRoot",
+        "r10.weaponLr",
+        "r10.legacySample",
+        "r10.frame",
+        "r10.bodyHistory",
+        "capture.commit",
+        // level 1: AnimSyncCapture.commit
+        "capture.identityTake",
+        "capture.freeze",
+        "capture.seal",
+        "capture.retain",
+        "capture.tail",
+        // level 2: AnimSyncCapture.freeze / retain
+        "freeze.vanilla",
+        "freeze.paLrTacz",
+        "freeze.createSbw",
+        "freeze.parcool",
+        "freeze.validate",
+        "freeze.stage",
+        "retain.roundTrip",
+        "retain.rest",
+        // level 0 (stream): AnimSyncStream.prepare/publish per observer
+        "stream.prepareRecords",
+        "stream.fold",
+        "stream.prepareEncode",
+        "stream.publishPrune",
+        "stream.publishRest",
+        // level 1 (stream): fold
+        "fold.inputs",
+        "fold.reduce",
+        "fold.commit",
+    };
+
+    static final int R_INPUTS = 0,
+            R_PARCOOL = 1,
+            R_WEAPON = 2,
+            R_SAMPLE = 3,
+            R_FRAME = 4,
+            R_HISTORY = 5,
+            C_COMMIT = 6,
+            C_IDENTITY = 7,
+            C_FREEZE = 8,
+            C_SEAL = 9,
+            C_RETAIN = 10,
+            C_TAIL = 11,
+            F_VANILLA = 12,
+            F_PA = 13,
+            F_CREATE_SBW = 14,
+            F_PARCOOL = 15,
+            F_VALIDATE = 16,
+            F_STAGE = 17,
+            T_ROUNDTRIP = 18,
+            T_REST = 19,
+            S_RECORDS = 20,
+            S_FOLD = 21,
+            S_ENCODE = 22,
+            S_PRUNE = 23,
+            S_PUBLISH = 24,
+            D_INPUTS = 25,
+            D_REDUCE = 26,
+            D_COMMIT = 27;
+
+    static final long[] NANOS = new long[NAMES.length];
+    static final long[] COUNT = new long[NAMES.length];
+    static final long[] MOCKS = new long[NAMES.length];
+    private static final long[] MARK = new long[3];
+    private static final long[] MOCK_MARK = new long[3];
+
+    static void begin(int level) {
+        if (!on) return;
+        MARK[level] = System.nanoTime();
+        MOCK_MARK[level] = mockCalls;
+    }
+
+    static void lap(int level, int slot) {
+        if (!on) return;
+        long now = System.nanoTime();
+        NANOS[slot] += now - MARK[level];
+        MOCKS[slot] += mockCalls - MOCK_MARK[level];
+        COUNT[slot]++;
+        MARK[level] = now;
+        MOCK_MARK[level] = mockCalls;
+    }
+
+    public static void reset() {
+        java.util.Arrays.fill(NANOS, 0);
+        java.util.Arrays.fill(COUNT, 0);
+        java.util.Arrays.fill(MOCKS, 0);
+    }
+
+    /** Per slot: total nanos, laps, mock calls. */
+    public static Map<String, Object> snapshot(int ticks) {
+        var result = new LinkedHashMap<String, Object>();
+        for (int i = 0; i < NAMES.length; i++) {
+            if (COUNT[i] == 0) continue;
+            var row = new LinkedHashMap<String, Object>();
+            row.put("msPerTick", NANOS[i] / 1e6 / ticks);
+            row.put("usPerLap", NANOS[i] / 1e3 / COUNT[i]);
+            row.put("lapsPerTick", (double) COUNT[i] / ticks);
+            row.put("mockCallsPerLap", (double) MOCKS[i] / COUNT[i]);
+            result.put(NAMES[i], row);
+        }
+        return result;
+    }
+}
