diff --git a/server/src/oracleTest/java/com/lunares/blockfield/server/combat/AnimSyncParallelProto.java b/server/src/oracleTest/java/com/lunares/blockfield/server/combat/AnimSyncParallelProto.java
new file mode 100644
index 00000000..98919d9b
--- /dev/null
+++ b/server/src/oracleTest/java/com/lunares/blockfield/server/combat/AnimSyncParallelProto.java
@@ -0,0 +1,263 @@
+package com.lunares.blockfield.server.combat;
+
+import com.lunares.blockfield.common.combat.AnimationResources;
+import com.lunares.blockfield.common.combat.AnimationSchema;
+import com.lunares.blockfield.common.combat.AnimationState;
+import com.lunares.blockfield.common.combat.ObserverReducer;
+import com.lunares.blockfield.network.packet.PlayerSnapshotS2CPacket;
+import io.netty.buffer.Unpooled;
+import java.lang.management.ManagementFactory;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.Callable;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.ThreadPoolExecutor;
+import net.minecraft.network.FriendlyByteBuf;
+
+/**
+ * UPAR-1 PROTOTYPE (not production code). Replays, after each measured benchmark tick and outside
+ * the benchmark's own timing, the tick's pure work of three stages on fixed pools of 1..4 worker
+ * threads and on the calling thread: the observer fold reductions ({@link ObserverReducer#reduce}
+ * without a memo, the cost of a fold that replays its seed), the retention round trips of the
+ * tick's checkpoints ({@link AnimSyncLedger#roundTrip}) and the snapshot batch encodes of every
+ * observer (with the tick's shared component encodings registered on each thread, as the main
+ * thread does). Every variant's results must be bit-identical to the calling thread's: equal
+ * values, equal encoded bytes, equal exception class and message.
+ */
+final class AnimSyncParallelProto implements AutoCloseable {
+    private static final com.sun.management.ThreadMXBean MX =
+            (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+
+    /** Pool sizes; 0 is the calling (benchmark main) thread, the serial reference. */
+    private final int[] sizes;
+
+    private final Map<Integer, ExecutorService> pools = new LinkedHashMap<>();
+    private final Map<Integer, List<Thread>> threads = new LinkedHashMap<>();
+    // stage -> size -> per-tick series
+    private final Map<String, Map<Integer, AnimSyncBench.Series>> wall = new LinkedHashMap<>();
+    private final Map<String, Map<Integer, AnimSyncBench.Series>> cpu = new LinkedHashMap<>();
+    private final Map<String, Long> tasks = new LinkedHashMap<>();
+    private final Map<String, Long> mismatches = new LinkedHashMap<>();
+    private final Map<String, Long> failures = new LinkedHashMap<>();
+    private long ticks;
+
+    final List<AnimSyncStream.FoldInputs> folds = new ArrayList<>();
+    final List<AnimationState> retained = new ArrayList<>();
+    final List<PlayerSnapshotS2CPacket> packets = new ArrayList<>();
+    final List<AnimationState> shared = new ArrayList<>();
+    long tick;
+
+    AnimSyncParallelProto(int[] sizes) {
+        this.sizes = sizes;
+        for (int size : sizes) {
+            if (size == 0) continue;
+            var created = new ArrayList<Thread>();
+            int n = size;
+            var pool =
+                    (ThreadPoolExecutor)
+                            Executors.newFixedThreadPool(
+                                    size,
+                                    runnable -> {
+                                        var thread =
+                                                new Thread(
+                                                        runnable,
+                                                        "upar-proto-" + n + "-" + created.size());
+                                        thread.setDaemon(true);
+                                        created.add(thread);
+                                        return thread;
+                                    });
+            pool.prestartAllCoreThreads();
+            pools.put(size, pool);
+            threads.put(size, created);
+        }
+        for (String stage : List.of("fold", "retain", "encode")) {
+            wall.put(stage, new LinkedHashMap<>());
+            cpu.put(stage, new LinkedHashMap<>());
+            for (int size : sizes) {
+                wall.get(stage).put(size, new AnimSyncBench.Series());
+                cpu.get(stage).put(size, new AnimSyncBench.Series());
+            }
+        }
+    }
+
+    /** Starts collecting one tick's work through the production probes. */
+    void begin(long tick) {
+        this.tick = tick;
+        folds.clear();
+        retained.clear();
+        packets.clear();
+        shared.clear();
+        AnimSyncStream.FOLD_PROBE = folds::add;
+        AnimSyncCapture.RETAIN_PROBE = retained::add;
+    }
+
+    /** Stops collecting and replays the tick on every pool size, rotating the order per tick. */
+    void end() throws Exception {
+        AnimSyncStream.FOLD_PROBE = null;
+        AnimSyncCapture.RETAIN_PROBE = null;
+        ticks++;
+        var foldWork = List.copyOf(folds);
+        var retainWork = List.copyOf(retained);
+        var packetWork = List.copyOf(packets);
+        var sharedWork = List.copyOf(shared);
+        long scope = tick;
+        List<Callable<Object>> foldTasks = new ArrayList<>();
+        for (var in : foldWork) foldTasks.add(() -> fold(in));
+        List<Callable<Object>> retainTasks = new ArrayList<>();
+        for (var state : retainWork) retainTasks.add(() -> retain(state));
+        List<Callable<Object>> encodeTasks = new ArrayList<>();
+        for (var packet : packetWork) encodeTasks.add(() -> encode(scope, sharedWork, packet));
+        int rotation = (int) (ticks % sizes.length);
+        Map<String, List<Object>> reference = new LinkedHashMap<>();
+        // The calling thread runs first every tick: it is the serial reference.
+        reference.put("fold", run("fold", 0, foldTasks));
+        reference.put("retain", run("retain", 0, retainTasks));
+        reference.put("encode", run("encode", 0, encodeTasks));
+        for (int i = 0; i < sizes.length; i++) {
+            int size = sizes[(i + rotation) % sizes.length];
+            if (size == 0) continue;
+            compare("fold", reference.get("fold"), run("fold", size, foldTasks));
+            compare("retain", reference.get("retain"), run("retain", size, retainTasks));
+            compare("encode", reference.get("encode"), run("encode", size, encodeTasks));
+        }
+        tasks.merge("fold", (long) foldTasks.size(), Long::sum);
+        tasks.merge("retain", (long) retainTasks.size(), Long::sum);
+        tasks.merge("encode", (long) encodeTasks.size(), Long::sum);
+    }
+
+    private List<Object> run(String stage, int size, List<Callable<Object>> work)
+            throws Exception {
+        var out = new ArrayList<Object>(work.size());
+        if (size == 0) {
+            long cpu0 = MX.getCurrentThreadCpuTime();
+            long start = System.nanoTime();
+            for (var task : work) out.add(call(task));
+            wall.get(stage).get(0).add(System.nanoTime() - start);
+            cpu.get(stage).get(0).add(MX.getCurrentThreadCpuTime() - cpu0);
+            return out;
+        }
+        var pool = pools.get(size);
+        long cpu0 = poolCpu(size);
+        long start = System.nanoTime();
+        List<Callable<Object>> wrapped = new ArrayList<>(work.size());
+        for (var task : work) wrapped.add(() -> call(task));
+        List<Future<Object>> futures = pool.invokeAll(wrapped);
+        for (var future : futures) out.add(future.get());
+        wall.get(stage).get(size).add(System.nanoTime() - start);
+        cpu.get(stage).get(size).add(poolCpu(size) - cpu0);
+        return out;
+    }
+
+    private long poolCpu(int size) {
+        long total = 0;
+        for (var thread : threads.get(size)) total += MX.getThreadCpuTime(thread.threadId());
+        return total;
+    }
+
+    /** A task's value, or its exception as a comparable value (class and message). */
+    private static Object call(Callable<Object> task) {
+        try {
+            return task.call();
+        } catch (Throwable thrown) {
+            return "threw:" + thrown.getClass().getName() + ":" + thrown.getMessage();
+        }
+    }
+
+    private static Object fold(AnimSyncStream.FoldInputs in) {
+        var result =
+                ObserverReducer.reduce(
+                        in.seed(),
+                        in.activation(),
+                        in.bucket(),
+                        in.checkpoints(),
+                        in.applied(),
+                        in.tacz(),
+                        in.lr(),
+                        in.policy());
+        // The value and the bytes the successor seed would carry.
+        return List.of(result, Arrays.hashCode(AnimationSchema.encode(result.pa().graph())));
+    }
+
+    private static Object retain(AnimationState state) {
+        var decoded = AnimSyncLedger.roundTrip(state);
+        if (!decoded.value().equals(state)) return "changed";
+        return List.of(decoded.value(), decoded.bytes(), decoded.digest());
+    }
+
+    private static Object encode(
+            long scope, List<AnimationState> shared, PlayerSnapshotS2CPacket packet) {
+        // The main thread registers each target's checkpoint once per tick (AnimSyncStream.share);
+        // a worker registers the same immutable values in its own thread-confined registry.
+        for (var state : shared)
+            for (Object component :
+                    Arrays.asList(
+                            state.placement(),
+                            state.vanilla(),
+                            state.stance(),
+                            state.equipment(),
+                            state.tacz(),
+                            state.lr(),
+                            state.graph(),
+                            state.parcool(),
+                            state.create(),
+                            state.sbw(),
+                            state.decisions())) AnimationSchema.shareEncoding(scope, component);
+        var buf = new FriendlyByteBuf(Unpooled.buffer());
+        try {
+            PlayerSnapshotS2CPacket.ANIMATION_CODEC.encode(buf, packet);
+            byte[] bytes = new byte[buf.readableBytes()];
+            buf.readBytes(bytes);
+            return AnimationResources.Digest.hash(bytes);
+        } finally {
+            buf.release();
+        }
+    }
+
+    private void compare(String stage, List<Object> expected, List<Object> actual) {
+        if (expected.size() != actual.size()) {
+            mismatches.merge(stage, 1L, Long::sum);
+            return;
+        }
+        for (int i = 0; i < expected.size(); i++) {
+            var a = expected.get(i);
+            var b = actual.get(i);
+            if (a instanceof String s && s.startsWith("threw:")) failures.merge(stage, 1L, Long::sum);
+            if (!Objects.equals(a, b)) mismatches.merge(stage, 1L, Long::sum);
+        }
+    }
+
+    Map<String, Object> results() {
+        var out = new LinkedHashMap<String, Object>();
+        out.put("ticks", ticks);
+        out.put("sizes", Arrays.toString(sizes));
+        out.put("tasks", tasks);
+        out.put("mismatches", mismatches);
+        out.put("referenceExceptions", failures);
+        var stages = new LinkedHashMap<String, Object>();
+        for (String stage : wall.keySet()) {
+            var bySize = new LinkedHashMap<String, Object>();
+            for (int size : sizes) {
+                var entry = new LinkedHashMap<String, Object>();
+                entry.put("wallNanosPerTick", wall.get(stage).get(size).stats());
+                entry.put("cpuNanosPerTick", cpu.get(stage).get(size).stats());
+                bySize.put(size == 0 ? "caller" : "pool" + size, entry);
+            }
+            stages.put(stage, bySize);
+        }
+        out.put("stages", stages);
+        return out;
+    }
+
+    @Override
+    public void close() {
+        AnimSyncStream.FOLD_PROBE = null;
+        AnimSyncCapture.RETAIN_PROBE = null;
+        for (var pool : pools.values()) pool.shutdownNow();
+    }
+}
