# Build context is generated by launch.py, never the repository or a home directory.
FROM eclipse-temurin:21-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    xvfb libgl1-mesa-dri libglx-mesa0 libasound2 libxrandr2 libxi6 libxcursor1 \
    libxinerama1 libxxf86vm1 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/pmc && /opt/pmc/bin/pip install --no-deps --require-hashes -r /dev/stdin <<'REQ'
portablemc==4.4.1 --hash=sha256:82435214f4745fb0b5a6dbbb065b1b22723f5805d2468a74c896b33733eb2de6
REQ
COPY gradle.properties source-sha.txt dependencies.json /opt/bf/
COPY jars/ /opt/bf/jars/
COPY provision.py session.py pvp_scenario.py /opt/bf/tools/
RUN /opt/pmc/bin/python /opt/bf/tools/provision.py
ENV HOME=/tmp/rig-home LIBGL_ALWAYS_SOFTWARE=1 DISPLAY=:99
ENTRYPOINT ["python3", "/opt/bf/tools/session.py"]
